+when defined(nimCproc) and useLibC:
+  # Use libc's const-correct source parameter instead of a generated void* wrapper.
+  proc nimCopyMem*(dest, source: pointer; size: Natural) {.
+    importc: "nimCopyMem", header: "<string.h>", raises: [], tags: [], nonReloadable, compilerproc.}
+else:
+  proc nimCopyMem*(dest, source: pointer, size: Natural) {.nonReloadable, compilerproc, inline.} =
+    when useLibC:
+      c_memcpy(dest, source, cast[csize_t](size))
+    else:
+      let d = cast[ptr UncheckedArray[byte]](dest)
+      let s = cast[ptr UncheckedArray[byte]](source)
+      var i = 0
+      while i < size:
+        d[i] = s[i]
+        inc i
 
